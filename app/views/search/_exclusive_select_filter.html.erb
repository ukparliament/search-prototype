<% unless @search_data.filter_groups.dig(name).blank? %>
  <% if selected %>
    <%= render 'exclusive_select_group', group_name: name, filters: format_filter_group(name, @search_data.filter_groups.dig(name), matching_value: selected), suffix: suffix %>
  <% else %>
    <%= render 'multi_select_group', group_name: name, filters: format_filter_group(name, @search_data.filter_groups.dig(name)) %>
  <% end %>
<% end %>
