<div class="result-item pb-3">
  <h3 class="h5">
    <%= link_to(format_object_title(object.object_title, @ses_data), object_show_url(object: object.object_uri[:value])) %>
  </h3>

  <p class="mb-2">
    <%= strip_tags(controller.render_to_string(partial: object.prelim_template, locals: { object: object })).squish %>
  </p>

  <div class="d-flex flex-wrap text-secondary small">
    <% unless object.standard_date.blank? %>
      <span class="significant-date mr-2">
        <%= format_date_without_day(object.standard_date) %>
      </span>
    <% end %>
    <% unless object.standard_reference.blank? || object.standard_reference.pluck(:value) == ["."] %>
      <span class="reference mr-2">
        <%= object.standard_reference.pluck(:value).join('; ') %>
      </span>
    <% end %>
    <% unless object.legislature.blank? %>
      <%= render 'content_type_objects/fragments/simple_list', items: object.legislature, terminator: "", singular: false, class: 'house' %>
    <% end %>
  </div>
</div>