<section class="facet">
  <h4 class="facet-heading <%= 'inactive' if filters&.size == 0 %>" id="<%= group_name.parameterize %>"><%= group_name %></h4>
  <% filters.each do |facet| %>
    <div>
      <%= link_to_if(false, "#{object_display_name({ value: facet["val"], field_name: replace_field_name(facet["field_name"]) }, singular: false, reading_order: false)} #{suffix} (#{number_to_delimited(facet["count"], separator: ",")})", apply_filter_url(request.params, replace_field_name(facet["field_name"]), facet["val"]), class: "menu-link modifiable-link", title: scope_note("#{facet["val"]}_scope_note")) %>
    </div>
  <% end %>
</section>