<% content_for :table_of_contents do %>
  <nav id="table-of-contents" class="help-toc" aria-labelledby="nav--meta">
    <h2 class="doc-list-heading" id="nav--about">
      On this page
    </h2>

    <ul class="doc-list doc-list-small">
      <% @alphabetised_headings.each do |group| %>
        <h3 id="<%= group.first %>" class="doc-list-heading"><%= group.first.titleize %></h3>
        <% group.last.each do |heading| %>
          <li>
            <a href="<%= aliases_url %>#<%= heading %>" class="doc-list__link">
              <%= heading %>
            </a>
          </li>
        <% end %>
      <% end %>
    </ul>
  </nav>
<% end %>
